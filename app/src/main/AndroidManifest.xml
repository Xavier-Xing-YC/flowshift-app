<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 查询已安装应用列表，用于自由选择受限App和目标学习App -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 使用情况访问权限：精准统计今日累计时长，并作为无障碍窗口检测的双重兜底 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 悬浮窗权限：用于后台调起目标App，以及绘制无缝上滑飞出/底部飞入过渡幕布 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台常驻服务权限：防止国产ROM杀后台导致掉无障碍权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="瞬移锁 FlowShift"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 透明过渡桥接 Activity：配合 WindowManager 幕布实现跨App向上飞出/底部飞入动画 -->
        <activity
            android:name=".ui.TransitionBridgeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 核心无障碍服务：监听前台应用切换与下滑手势 (TYPE_VIEW_SCROLLED) -->
        <service
            android:name=".service.SwipeInterceptAccessibilityService"
            android:exported="true"
            android:label="瞬移锁 · 手势与时间锁引擎"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="time_lock_and_habit_redirect_accessibility_guard" />
        </service>

    </application>
</manifest>
